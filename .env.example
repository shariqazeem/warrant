# X Layer mainnet (chain 196). The primary RPC, and a second one tried when it fails.
NEXT_PUBLIC_XLAYER_RPC=https://rpc.xlayer.tech
# The fallback RPC, used with retry and backoff when the primary refuses or times out.
XLAYER_RPC_FALLBACK=

# The public address the site is served on: share cards, the sitemap and links use it.
SITE_URL=

# The OKX DEX aggregator. Nothing routes without these; create them in the OKX developer portal.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# The OKX DEX router and its approval proxy that the contracts were deployed with. The deploy
# scripts and `npm run verify-deploy` read them; the app reads each contract's own.
OKX_ROUTER=
OKX_ROUTER_SPENDER=

# Script-only keys. Never on the web server: the deploy refuses a server env holding one.
PAYER_PRIVATE_KEY=
# The keeper's key: a wallet holding only a little OKB for gas, and nothing else.
KEEPER_PRIVATE_KEY=

# The keeper, run on its own machine.
# The env file it reads its key and settings from (kept out of git, e.g. .env.keeper).
KEEPER_ENV_FILE=
# The port its health endpoint answers on.
KEEPER_HEALTH_PORT=
# Below this much OKB the keeper alerts the founder.
KEEPER_MIN_OKB=
# The Telegram bot token and chat the keeper alerts on failure or a low balance.
KEEPER_TELEGRAM_TOKEN=
KEEPER_TELEGRAM_CHAT=

# Contracts on X Layer mainnet
NEXT_PUBLIC_PAYROLL_ADDRESS=
NEXT_PUBLIC_GRANT_ESCROW_ADDRESS=

# Assets, verified on chain. USD₮0 is what Warrant pays with; the default stock is SPYx.
# lib/assets.ts carries the fifteen, and docs/liquidity.md the measurements.
NEXT_PUBLIC_STABLE=0x779Ded0c9e1022225f8E0630b35a9b54bE713736
NEXT_PUBLIC_DEFAULT_ASSET=0x90a2a4c76b5d8c0bc892a69ea28aa775a8f2dd48

# The record: a SQLite cache of the chain's events.
WARRANT_DB_PATH=var/warrant.db
