# X Layer
NEXT_PUBLIC_CHAIN_ID=196
NEXT_PUBLIC_XLAYER_RPC=https://rpc.xlayer.tech

# The OKX DEX aggregator. Nothing routes without these; create them in the OKX developer portal.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# The wallet that pays and the keeper that vests
PAYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=

# Contracts, filled in after deploy
NEXT_PUBLIC_PAYROLL_ADDRESS=
NEXT_PUBLIC_GRANT_ESCROW_ADDRESS=

# Assets, verified on chain 19 September 2026. The default is SPYx; lib/assets.ts
# carries the rest and docs/liquidity.md carries the measurements.
NEXT_PUBLIC_STABLE=0x779Ded0c9e1022225f8E0630b35a9b54bE713736
NEXT_PUBLIC_DEFAULT_ASSET=0x90a2a4c76b5d8c0bc892a69ea28aa775a8f2dd48

WARRANT_DB_PATH=var/warrant.db
